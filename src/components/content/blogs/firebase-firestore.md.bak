## 🧠 Pro Tips

### Security Rules Example

```javascript
# javascript
# copy
# edit
// Firestore Rules
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow read/write access on all documents to authenticated users
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
    
    // Task-specific rules
    match /tasks/{taskId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == resource.data.userId;
    }
  }
}
```

### Batch Operations

```javascript
# javascript
# copy
# edit
import { writeBatch, doc } from "firebase/firestore";

// Batch multiple operations
async function batchUpdate() {
  const batch = writeBatch(db);
  
  // Update multiple documents atomically
  batch.set(doc(db, "tasks", "task1"), { status: "completed" });
  batch.update(doc(db, "users", "user1"), { taskCount: increment(1) });
  batch.delete(doc(db, "notifications", "notif1"));
  
  // Commit the batch
  await batch.commit();
}
```

